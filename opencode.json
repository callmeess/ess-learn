{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "csharp": {
      "command": [
        "/home/ess/.dotnet/tools/csharp-ls"
      ],
      "extensions": [
        "cs",
        "csproj",
        "sln"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        "ts",
        "tsx",
        "js",
        "jsx"
      ]
    },
    "json": {
      "command": [
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        "json",
        "jsonc"
      ]
    }
  }
}
