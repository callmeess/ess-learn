# MinIO (blob storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Blob storage credentials (used by the API to connect to MinIO)
BlobStorage__AccessKey=minioadmin
BlobStorage__SecretKey=minioadmin

# Frontend / SSR
PORT=4000

# Frontend (dev server) - points to the backend API
VITE_API_URL=http://localhost:5000

# PostgreSQL
POSTGRES_DB=esslearn
POSTGRES_USER=esslearn
POSTGRES_PASSWORD=esslearn